<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>طراحان برتر | طراحی لوگو و هویت بصری</title>
<meta name="description" content="طراحان برتر؛ طراحی لوگو، پوستر، منوی رستوران و طرح مهر ژلاتینی">
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap');
:root{--gold:#c99a2e;--gold2:#f0cf72;--black:#11100e;--cream:#fbf7ed;--white:#fff;--muted:#6e6a61}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Vazirmatn,Tahoma,sans-serif;background:var(--cream);color:var(--black)}
a{text-decoration:none;color:inherit}.container{width:min(1160px,92%);margin:auto}
header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-bottom:1px solid #eadfca}
.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-size:25px;font-weight:900;display:flex;align-items:center;gap:10px}.brand-mark{width:38px;height:38px;border:2px solid var(--gold);border-radius:11px;display:grid;place-items:center;color:var(--gold);font-weight:900}
nav{display:flex;gap:26px;font-size:14px;font-weight:600;color:#393630}nav a:hover{color:var(--gold)}
.order-top{background:linear-gradient(135deg,#b98316,#e9c45e);color:#17130a;padding:11px 20px;border-radius:13px;font-weight:800;box-shadow:0 7px 18px #c99a2e30}
.hero{padding:62px 0 55px;background:radial-gradient(circle at 15% 20%,#fff 0,#fff8e8 35%,transparent 55%),linear-gradient(135deg,#fff,#f6eedc);border-bottom:1px solid #eadfca}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:45px}.eyebrow{color:#a97716;font-weight:800;margin-bottom:10px}.hero h1{font-size:clamp(36px,5vw,66px);line-height:1.15;margin:0 0 18px}.hero h1 span{color:var(--gold)}.hero p{font-size:17px;line-height:2;color:#59554d;max-width:650px}.hero-actions{display:flex;gap:12px;margin-top:25px;flex-wrap:wrap}.btn{padding:13px 22px;border-radius:13px;font-weight:800}.btn.gold{background:#c99a2e;color:white}.btn.light{border:1px solid #d8c8a5;background:white}.hero-card{min-height:320px;border-radius:30px;background:#15130f;box-shadow:0 24px 60px #1a140833;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.hero-card:before{content:"";position:absolute;width:320px;height:320px;border:2px solid #d5a83c;border-radius:50%;opacity:.25}.hero-logo{font-size:64px;font-weight:900;color:#fff;text-align:center;position:relative}.hero-logo small{display:block;color:#d9ad43;font-size:18px;letter-spacing:4px;margin-top:8px}
section{padding:64px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px}.section-head h2{font-size:30px;margin:0}.section-head p{color:var(--muted);margin:6px 0 0}
.services{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.service{background:#fff;border:1px solid #eee3ce;border-radius:20px;padding:25px 18px;text-align:center;box-shadow:0 10px 25px #3a2a1010}.icon{width:58px;height:58px;border-radius:16px;background:#fff7e4;border:1px solid #e5c97e;color:#b47e15;display:grid;place-items:center;margin:0 auto 15px;font-size:26px}.service h3{font-size:17px;margin:7px}.service p{font-size:13px;line-height:1.9;color:#777}
.portfolio{background:#fff}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.work{background:#f8f4ea;border:1px solid #eadfc9;border-radius:20px;overflow:hidden;box-shadow:0 12px 30px #4a361410}.work img{display:block;width:100%;height:310px;object-fit:cover}.work .cap{padding:13px 15px;font-weight:700}
.about{background:linear-gradient(135deg,#171511,#292319);color:#fff}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}.about h2{font-size:32px}.about p{color:#ddd1ba;line-height:2}.features{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.feature{border:1px solid #8d6b29;border-radius:17px;padding:18px;color:#f6e5bb}.feature b{display:block;margin-bottom:6px;color:#f0c95f}.contact{background:#fff}.contact-box{border:1px solid #e7dcc5;border-radius:25px;padding:30px;display:grid;grid-template-columns:1fr 1fr;gap:25px}.contact-item{padding:15px;border-radius:16px;background:#faf7f0}.contact-item b{display:block;margin-bottom:7px}.contact-item a{color:#9b6d16;font-weight:800}
footer{background:#11100e;color:#eee;padding:35px 0}.footer-grid{display:flex;justify-content:space-between;gap:20px;align-items:center}.footer-brand{font-size:23px;font-weight:900;color:#f0cf72}.copy{color:#aaa;font-size:12px}
@media(max-width:850px){nav{display:none}.hero-grid,.about-grid{grid-template-columns:1fr}.services{grid-template-columns:repeat(2,1fr)}.gallery{grid-template-columns:repeat(2,1fr)}.contact-box{grid-template-columns:1fr}.hero-card{min-height:250px}}
@media(max-width:520px){.services,.gallery{grid-template-columns:1fr}.work img{height:330px}.nav{height:64px}.order-top{padding:9px 13px;font-size:13px}.hero{padding-top:40px}.hero p{font-size:15px}.section-head h2{font-size:25px}}
</style>

<style>
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:100;display:none;align-items:center;justify-content:center;padding:28px}
.lightbox.open{display:flex}
.lightbox img{max-width:92vw;max-height:88vh;width:auto;height:auto;object-fit:contain;border-radius:12px;box-shadow:0 20px 70px rgba(0,0,0,.55)}
.lb-close,.lb-prev,.lb-next{position:fixed;border:1px solid #d9ad43;background:#171511;color:#f0cf72;border-radius:50%;width:48px;height:48px;font-size:26px;display:grid;place-items:center;cursor:pointer}
.lb-close{top:22px;left:22px}
.lb-prev{right:24px;top:50%;transform:translateY(-50%)}
.lb-next{left:24px;top:50%;transform:translateY(-50%)}
.work img{cursor:zoom-in}
@media(max-width:520px){.lightbox{padding:14px}.lightbox img{max-width:96vw;max-height:82vh}.lb-close{top:12px;left:12px}.lb-prev{right:10px}.lb-next{left:10px}}
</style>

<style>
.order-top{border:0;cursor:pointer;font-family:inherit}
.order-modal{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:90;display:none;align-items:center;justify-content:center;padding:20px}
.order-modal.open{display:flex}
.order-card{width:min(460px,94vw);background:#fff;border-radius:24px;border:1px solid #eadfca;box-shadow:0 25px 80px rgba(0,0,0,.35);padding:28px;position:relative;text-align:right}
.order-card h3{margin:0 0 8px;font-size:25px}.order-card p{margin:0 0 22px;color:#6e6a61}
.order-row{background:#fbf7ed;border:1px solid #eadfca;border-radius:16px;padding:15px;margin-top:12px}.order-row b{display:block;margin-bottom:7px}.order-row a{color:#9b6d16;font-weight:900}
.order-close{position:absolute;top:12px;left:12px;width:40px;height:40px;border-radius:50%;border:1px solid #d9ad43;background:#171511;color:#f0cf72;font-size:24px;cursor:pointer}
.price{display:block;margin-top:12px;color:#a87516;font-size:16px}</style>
</head>
<body>
<header>
  <div class="container nav">
    <a class="brand" href="#home"><span class="brand-mark">✦</span>طراحان برتر</a>
    <nav>
      <a href="#home">خانه</a><a href="#services">خدمات</a><a href="#portfolio">نمونه‌کارها</a><a href="#about">درباره ما</a><a href="#contact">تماس با ما</a>
    </nav>
    <button class="order-top" id="orderBtn" type="button">ثبت سفارش</button>
  </div>
</header>

<main id="home">
<section class="hero">
<div class="container hero-grid">
<div>
<div class="eyebrow" data-edit="eyebrow">ایده شما، هویت برند شما</div>
<h1 data-edit="heroTitle">طراحی حرفه‌ای با امضای <span>طراحان برتر</span></h1>
<p data-edit="heroDesc">طراحی لوگو، پوستر، منوی رستوران و طرح مهر ژلاتینی با تمرکز بر ظاهر حرفه‌ای، خوانایی و هویت ماندگار برند شما.</p>
<div class="hero-actions"><a class="btn gold" href="#portfolio">مشاهده نمونه‌کارها</a><a class="btn light" href="#services">خدمات ما</a></div>
</div>
<div class="hero-card"><div class="hero-logo">طراحان برتر<small>TOP DESIGNERS</small></div></div>
</div>
</section>

<section id="services">
<div class="container">
<div class="section-head"><div><h2>خدمات ما</h2><p>طراحی برای کسب‌وکارهای مدرن و ماندگار</p></div></div>
<div class="services">
<div class="service"><div class="icon">✒</div><h3 data-edit="service1Name">طراحی لوگو</h3><p data-edit="service1Desc">طراحی لوگوی اختصاصی و متناسب با هویت برند شما</p><strong class="price" data-edit="service1Price">200 تومان</strong></div>
<div class="service"><div class="icon">▣</div><h3 data-edit="service2Name">طراحی پوستر</h3><p data-edit="service2Desc">پوسترهای تبلیغاتی، فرهنگی و تجاری با ظاهر حرفه‌ای</p><strong class="price" data-edit="service2Price">250 تومان</strong></div>
<div class="service"><div class="icon">☷</div><h3 data-edit="service3Name">طراحی منوی رستوران</h3><p data-edit="service3Desc">منوهای جذاب و خوانا برای رستوران‌ها و کافه‌ها</p><strong class="price" data-edit="service3Price">300 تومان</strong></div>
<div class="service"><div class="icon">◉</div><h3 data-edit="service4Name">طرح مهر ژلاتینی</h3><p data-edit="service4Desc">فایل آماده و مناسب ساخت مهر ژلاتینی</p><strong class="price" data-edit="service4Price">100 تومان</strong></div>
</div>
</div>
</section>

<section id="portfolio" class="portfolio">
<div class="container">
<div class="section-head"><div><h2>نمونه‌کارها</h2><p>بخشی از طراحی‌های انجام‌شده توسط طراحان برتر</p></div></div>
<div class="gallery">
<div class="work" data-index="1"><img src="assets/portfolio-1.png" alt="نمونه کار طراحی"><div class="cap">نمونه طراحی لوگو و هویت بصری</div></div>
<div class="work" data-index="2"><img src="assets/portfolio-2.png" alt="نمونه کار طراحی"><div class="cap">لوگوی کافه و رستوران</div></div>
<div class="work" data-index="3"><img src="assets/portfolio-3.png" alt="نمونه کار طراحی"><div class="cap">طراحی لوگو و نشان تجاری</div></div>
<div class="work" data-index="4"><img src="assets/portfolio-4.png" alt="نمونه کار طراحی"><div class="cap">نمونه مهر و هویت برند</div></div>
<div class="work" data-index="5"><img src="assets/portfolio-5.png" alt="نمونه کار طراحی"><div class="cap">لوگوی رستوران</div></div>
<div class="work" data-index="6"><img src="assets/portfolio-6.png" alt="نمونه کار طراحی"><div class="cap">نمونه لوگوی آموزشی</div></div>
<div class="work" data-index="7"><img src="assets/portfolio-7.png" alt="نمونه کار طراحی"><div class="cap">نمونه لوگوی شخصی</div></div>
<div class="work" data-index="8"><img src="assets/portfolio-8.png" alt="نمونه کار طراحی"><div class="cap">نمونه لوگوی خدماتی</div></div>
<div class="work" data-index="9"><img src="assets/portfolio-9.png" alt="نمونه کار طراحی"><div class="cap">نمونه طراحی تبلیغاتی</div></div>
<div class="work" data-index="10"><img src="assets/portfolio-10.png" alt="نمونه کار طراحی"><div class="cap">نمونه طراحی خدماتی</div></div>
</div>
</div>
</section>

<section id="about" class="about">
<div class="container about-grid">
<div><h2 data-edit="aboutTitle">طراحی‌هایی که هویت می‌سازند</h2><p data-edit="aboutDesc">هدف ما ساخت طرح‌هایی است که فقط زیبا نباشند؛ بلکه برند شما را واضح، حرفه‌ای و متمایز نشان دهند.</p></div>
<div class="features"><div class="feature"><b>✦ خلاقیت</b>ایده‌های اختصاصی برای هر پروژه</div><div class="feature"><b>✓ کیفیت</b>توجه به جزئیات و خروجی حرفه‌ای</div><div class="feature"><b>◷ تحویل سریع</b>برنامه‌ریزی منظم پروژه</div><div class="feature"><b>◆ پشتیبانی</b>همراهی تا رسیدن به نتیجه مطلوب</div></div>
</div>
</section>



<section id="contact" class="contact">
<div class="container">
<div class="section-head"><div><h2>تماس با ما</h2><p>برای مشاوره و هماهنگی سفارش با ما تماس بگیرید.</p></div></div>
<div class="contact-box">
<div class="contact-item"><b>شماره تماس</b><a href="tel:09945665794">09945665794</a></div>
<div class="contact-item"><b>روبیکا</b><a href="https://rubika.ir/Ka289049" target="_blank" rel="noopener">@Ka289049</a></div>
</div>
</div>
</section>
</main>

<footer>
<div class="container footer-grid">
<div><div class="footer-brand">طراحان برتر</div><div class="copy">طراحی حرفه‌ای، هویت ماندگار</div></div>
<div><div class="copy">© طراحان برتر — تمامی حقوق محفوظ است.</div></div>
</div>
</footer>


<div class="order-modal" id="orderModal" aria-hidden="true">
  <div class="order-card" role="dialog" aria-modal="true" aria-labelledby="orderTitle">
    <button class="order-close" id="orderClose" type="button" aria-label="بستن">×</button>
    <h3 id="orderTitle">ثبت سفارش</h3>
    <p>برای ثبت سفارش از طریق روبیکا با ما در ارتباط باشید.</p>
    <div class="order-row"><b>آیدی سفارش در روبیکا</b><a href="https://rubika.ir/Ka289049" target="_blank" rel="noopener">@Ka289049</a></div>
    <div class="order-row"><b>آیدی کانال در روبیکا</b><a href="https://rubika.ir/Logo_tarahi_berter" target="_blank" rel="noopener">@Logo_tarahi_berter</a></div>
  </div>
</div>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lb-close" id="lbClose" aria-label="بستن">×</button>
  <button class="lb-prev" id="lbPrev" aria-label="نمونه قبلی">›</button>
  <img id="lbImage" src="" alt="نمایش بزرگ نمونه‌کار">
  <button class="lb-next" id="lbNext" aria-label="نمونه بعدی">‹</button>
</div>
<script>
(function(){
  const orderBtn = document.getElementById('orderBtn');
  const orderModal = document.getElementById('orderModal');
  const orderClose = document.getElementById('orderClose');
  function openOrder(){ orderModal.classList.add('open'); orderModal.setAttribute('aria-hidden','false'); }
  function closeOrder(){ orderModal.classList.remove('open'); orderModal.setAttribute('aria-hidden','true'); }
  orderBtn.addEventListener('click', openOrder);
  orderClose.addEventListener('click', closeOrder);
  orderModal.addEventListener('click', e=>{ if(e.target===orderModal) closeOrder(); });

  const works = Array.from(document.querySelectorAll('.work[data-index]'));
  const box = document.getElementById('lightbox');
  const image = document.getElementById('lbImage');
  let current = 0;
  function show(i){
    current = (i + works.length) % works.length;
    image.src = works[current].querySelector('img').src;
    image.alt = works[current].querySelector('img').alt;
    box.classList.add('open');
    box.setAttribute('aria-hidden','false');
  }
  function close(){ box.classList.remove('open'); box.setAttribute('aria-hidden','true'); image.src=''; }
  works.forEach((w,i)=>w.addEventListener('click',()=>show(i)));
  document.getElementById('lbClose').addEventListener('click',close);
  document.getElementById('lbPrev').addEventListener('click',()=>show(current-1));
  document.getElementById('lbNext').addEventListener('click',()=>show(current+1));
  box.addEventListener('click',e=>{if(e.target===box) close();});
  document.addEventListener('keydown',e=>{
    if(!box.classList.contains('open')) return;
    if(e.key==='Escape'){ close(); closeOrder(); }
    if(e.key==='ArrowRight') show(current-1);
    if(e.key==='ArrowLeft') show(current+1);
  });
})();
</script>
</body>
</html>
